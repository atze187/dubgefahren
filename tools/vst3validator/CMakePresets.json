{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "validator-windows",
      "displayName": "VST3 validator (Windows x64)",
      "binaryDir": "${sourceDir}/../../build/vst3validator",
      "architecture": { "value": "x64", "strategy": "set" },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "validator-macos",
      "displayName": "VST3 validator (macOS)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/../../build-macos/vst3validator",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" }
    }
  ],
  "buildPresets": [
    { "name": "validator-windows", "configurePreset": "validator-windows", "configuration": "Release", "targets": ["validator"] },
    { "name": "validator-macos", "configurePreset": "validator-macos", "targets": ["validator"] }
  ]
}
